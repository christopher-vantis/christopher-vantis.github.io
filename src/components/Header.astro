---
import { getLocalePath } from '../i18n/utils';

const { lang = 'de' } = Astro.props;
const currentPath = Astro.url.pathname;

const nav = {
  de: [
    { href: '/', label: 'Start' },
    { href: '/ueber-mich', label: 'Über mich' },
    { href: '/timeline', label: 'Forschung' },
    { href: '/projekte', label: 'Projekte' },
    { href: '/kontakt', label: 'Kontakt' },
  ],
  en: [
    { href: '/en/', label: 'Home' },
    { href: '/en/about', label: 'About' },
    { href: '/en/timeline', label: 'Research' },
    { href: '/en/projects', label: 'Projects' },
    { href: '/en/contact', label: 'Contact' },
  ],
};

const links = nav[lang] || nav.de;
const switchLang = lang === 'de' ? 'en' : 'de';
const switchLabel = lang === 'de' ? 'EN' : 'DE';
const switchHref = getLocalePath(currentPath, switchLang);

function isActive(href: string) {
  if (href === '/' || href === '/en/') {
    return currentPath === href;
  }
  return currentPath.startsWith(href);
}
---

<header class="header">
  <nav class="header__nav container">
    <a href={lang === 'de' ? '/' : '/en/'} class="header__logo">
      C<span class="header__logo-dot">_</span>vantis
    </a>

    <ul class="header__links" id="nav-links">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['header__link', { 'header__link--active': isActive(link.href) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="header__actions">
      <a href={switchHref} class="header__lang-switch" aria-label={`Switch to ${switchLang}`}>
        {switchLabel}
      </a>

      <button class="header__menu-btn" aria-label="Menü öffnen" aria-expanded="false" id="menu-btn">
        <span class="header__menu-icon"></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background-color: rgba(245, 240, 235, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-accent-light);
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .header__logo {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    color: var(--color-text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .header__logo-dot {
    color: var(--color-accent);
  }

  .header__links {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
  }

  .header__link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding-block: var(--space-xs);
    position: relative;
    transition: color var(--transition-fast);
  }

  .header__link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1.5px;
    background-color: var(--color-accent);
    transition: width var(--transition-base);
  }

  .header__link:hover::after,
  .header__link--active::after {
    width: 100%;
  }

  .header__link:hover,
  .header__link--active {
    color: var(--color-accent);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .header__lang-switch {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-accent-light);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .header__lang-switch:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .header__menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-xs);
  }

  .header__menu-icon,
  .header__menu-icon::before,
  .header__menu-icon::after {
    display: block;
    width: 20px;
    height: 1.5px;
    background-color: var(--color-text-primary);
    transition: all var(--transition-base);
  }

  .header__menu-icon {
    position: relative;
  }

  .header__menu-icon::before,
  .header__menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .header__menu-icon::before { top: -6px; }
  .header__menu-icon::after { top: 6px; }

  @media (max-width: 768px) {
    .header__menu-btn {
      display: block;
    }

    .header__links {
      display: none;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      flex-direction: column;
      background-color: rgba(245, 240, 235, 0.95);
      backdrop-filter: blur(12px);
      padding: var(--space-lg);
      gap: var(--space-md);
      border-bottom: 1px solid var(--color-accent-light);
    }

    .header__links.is-open {
      display: flex;
    }
  }
</style>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const navLinks = document.getElementById('nav-links');

  menuBtn?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('is-open');
    menuBtn.setAttribute('aria-expanded', String(isOpen));
  });
</script>
