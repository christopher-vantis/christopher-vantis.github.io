  <nav class="header__nav container">
    <a href={lang === 'de' ? '/' : '/en/'} class="header__logo">
      C<span class="header__logo-dot">_</span>vantis
    </a>

    <ul class="header__links" id="nav-links">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['header__link', { 'header__link--active': isActive(link.href) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
