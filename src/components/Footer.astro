---
const { lang = 'de' } = Astro.props;
const year = new Date().getFullYear();

const text = {
  de: {
    line: 'Christopher Vantis · Gebaut mit ClaudeCode &',
  },
  en: {
    line: 'Christopher Vantis · Built with ClaudeCode &',
  },
};

const t = text[lang] || text.de;
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__divider"></div>
    <p class="footer__text">
      &copy; {year} {t.line} <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-xl);
    margin-top: auto;
  }

  .footer__inner {
    text-align: center;
  }

  .footer__divider {
    width: 100%;
    height: 1px;
    background-color: var(--color-accent-light);
    margin-bottom: var(--space-lg);
  }

  .footer__text {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
  }
</style>
