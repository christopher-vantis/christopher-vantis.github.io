---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { t } from '../i18n/utils';
import heroImage from '../assets/hero-illustration.png';
const lang = 'de';
const i = t(lang);
---

<BaseLayout title={`${i.hero.name} – ${i.site.description}`} lang={lang}>

  <section class="hero section">
    <div class="container">
      <div class="hero__visual">
        <Image
          src={heroImage}
          alt="Digitale Gesellschaft – Illustration"
          class="hero__image"
          widths={[800, 1200, 1600]}
          sizes="(max-width: 768px) 100vw, 1152px"
        />
      </div>
      <div class="hero__content">
        <p class="hero__greeting">{i.hero.greeting}</p>
        <h1 class="hero__name">{i.hero.name}</h1>
        <p class="hero__subtitle">{i.hero.subtitle}</p>
        <p class="hero__tagline">{i.hero.tagline}</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .hero .container {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .hero__visual {
    width: 100%;
  }

  .hero__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }

  .hero__content {
    max-width: 680px;
  }

  .hero__greeting {
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  .hero__name {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    margin-bottom: var(--space-md);
    letter-spacing: -0.03em;
  }

  .hero__subtitle {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  .hero__tagline {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 600px;
    line-height: 1.7;
  }
</style>
